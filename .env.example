# Copy to .env and fill in to run against a real store.
# With these unset the server runs on demo fixtures, which is the default.

# Store handle. "acme-supplies", "acme-supplies.myshopify.com" and the full
# https:// URL are all accepted; the server normalises it.
SHOPIFY_SHOP=

# Custom app Admin API access token. Needs read_orders, read_products and
# read_inventory. The server has no write path, so grant nothing else.
SHOPIFY_ACCESS_TOKEN=

# Optional. Defaults to 2025-07.
SHOPIFY_API_VERSION=

# Optional. Set to "mock" to force fixtures even with credentials present,
# which is handy when demoing.
SHOPIFY_MCP_MODE=
